# Closet 404 environment. Copy to .env.local and fill in.

# --- Open-weight model (required) -------------------------------------------
# Option 1: fully local with Ollama. No keys, no internet after `ollama pull`.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4:e4b
LLM_API_KEY=ollama

# Option 2: the same Gemma 4 open weights served by Google AI Studio
# (OpenAI-compatible endpoint, free tier). Use for hosting without a GPU.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemma-4-31b-it
# LLM_API_KEY=your_google_ai_studio_key

# Optional second open-weight model tried when the first returns 429/5xx.
# LLM_FALLBACK_MODEL=gemma-4-26b-a4b-it

# --- Coroner: live web search (optional) ------------------------------------
# Needed only for scripts/coroner.ts and live inquests on resurrected URLs.
# SERPAPI_API_KEY=

# --- Ghost voice (optional) -------------------------------------------------
# Without a key the browser's own speech synthesis is used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Public URL (optional) ---------------------------------------------------
# Used for share-card links. Render sets RENDER_EXTERNAL_URL on its own.
# SITE_URL=https://closet404.tech
